# 复制为 .env.local（next start 会自动读取），或作为 systemd EnvironmentFile。
# 任意 OpenAI 兼容的 /chat/completions 接口
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 单价：元 / 百万 token，用于实时记账（填 0 则只记 token 不记钱）
LLM_PRICE_IN=0
LLM_PRICE_OUT=0
# 花费上限（元），不设或 0 为不限
# LLM_DAILY_BUDGET_YUAN=1
# LLM_RUN_BUDGET_YUAN=0.2
# 每次推算最多调用次数，不设为不限
# LLM_RUN_MAX_CALLS=20
# 接口不支持 response_format 时设为 0
LLM_JSON_MODE=0
# 不连模型、不花钱，跑通流程
# LLM_MOCK=1
